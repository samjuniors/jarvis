# =============================================================================
# SOFIA / JARVIS — .env.local (the one file to inspect every key in)
# =============================================================================
# Every setting the app uses lives here or defaults. Nothing is committed;
# a blank or missing line simply means "use the default".
#
# Two processes read this file:
#   • the FRONTEND (the built app)  — every VITE_* line, at build time
#   • the BRIDGE (bridge/server.mjs) — every other line, at startup
#     (a variable already set in the shell always wins over this file)
#
# The brain itself needs NO key in this sandbox: it runs on the z-ai SDK,
# which is pre-authenticated on this machine. Same for the neural voices.

# ── FRONTEND ─────────────────────────────────────────────────────────────────

# How the app reaches the bridge. 'same-origin' = derive from the page's own
# URL, so it works through the preview gateway without absolute hosts.
VITE_BRIDGE_URL=same-origin

# 'bridge' (default) — the Node server does the thinking, holds every tool.
# 'direct' — the browser calls the model itself (needs VITE_ANTHROPIC_API_KEY,
# and only remote tools work). Leave on 'bridge'.
VITE_BACKEND=bridge

# Frontend speech engine: 'system' (default — the browser's own voices, used
# as the fallback) or 'kokoro' (an 86 MB in-browser neural voice download).
# The conversational voices ride the bridge, not this.
VITE_TTS_ENGINE=system

# Which Kokoro voice, if VITE_TTS_ENGINE=kokoro:
# bm_george | bm_fable | bm_lewis | bm_daniel
VITE_KOKORO_VOICE=bm_george

# Force ElevenLabs even when the bridge reports otherwise (needs a key below).
VITE_USE_ELEVENLABS=false

# Direct-mode keys (only used when the bridge is not in the path).
VITE_ANTHROPIC_API_KEY=
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_PICOVOICE_ACCESS_KEY=

# ── BRIDGE (bridge/server.mjs) ────────────────────────────────────────────────

# Port the bridge listens on. 3000 in this sandbox (it also serves the built
# app from dist/); 8787 when running locally per the README.
JARVIS_BRIDGE_PORT=8787

# ElevenLabs — optional. When set, /tts switches to ElevenLabs and /stt to
# Scribe; when blank (default) the built-in z-ai neural voices speak and the
# browser's recogniser listens. No key is needed for the neural voices.
ELEVENLABS_API_KEY=

# Which ElevenLabs voice, when a key is set.
JARVIS_VOICE_ID=

# Extra browser origins allowed to open the bridge socket, comma separated.
JARVIS_ALLOWED_ORIGINS=

# Accept clients that send no Origin header (curl, scripts). 1 in the sandbox.
JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories /file may serve images from, comma separated.
JARVIS_FILE_ROOTS=

# The neural voice catalogue is fixed in server.mjs (ZAI_VOICES):
#   female — tongtong (warm), chuichui (lively), kazi (crisp),
#            douji (smooth), luodo (expressive)
#   male   — jam (british), xiaochen (steady)
# Pick between them in the app's settings panel (top-right gear) or press V.

# ── FALLBACK CHAINS (see SETUP.md) ───────────────────────────────────────────
# Every service has alternates, tried in order when one fails. A blank line
# means the link is off. The chains:
#   brain  z-ai → Gemini → local (Ollama / LM Studio / vLLM / llama.cpp)
#   ear    Deepgram → ElevenLabs Scribe → z-ai ASR → local
#   voice  ElevenLabs → z-ai neural → local → the browser's own voice

# Brain, link 2: Google Gemini through its OpenAI-compatible endpoint.
# Key: https://aistudio.google.dev/apikey (free tier is generous).
GEMINI_API_KEY=
GEMINI_MODEL=

# Brain, link 3: any OpenAI-compatible chat server. For Ollama the /v1 is
# added for you (http://localhost:11434). OLLAMA_BASE_URL works as an alias.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Ear, link 1: Deepgram — fastest and cheapest. Key:
# https://console.deepgram.com (free credit on signup).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=

# Ear, link 4: an OpenAI-compatible transcription server — faster-whisper,
# speaches, LocalAI. POSTs to {LOCAL_STT_URL}/audio/transcriptions.
LOCAL_STT_URL=
LOCAL_STT_MODEL=
LOCAL_STT_API_KEY=

# Voice, link 3: an OpenAI-compatible speech server — kokoro-fastapi,
# LocalAI, openedai-speech. POSTs to {LOCAL_TTS_URL}/audio/speech.
LOCAL_TTS_URL=
LOCAL_TTS_MODEL=
LOCAL_TTS_VOICE=
LOCAL_TTS_API_KEY=

# Pins — collapse a chain to exactly one link (for testing, or on purpose).
# LLM: zai | gemini | local · STT: deepgram | elevenlabs | zai | local ·
# TTS: elevenlabs | zai | local. Empty = the full automatic chain.
JARVIS_LLM_PROVIDER=
JARVIS_STT_PROVIDER=
JARVIS_TTS_PROVIDER=
